// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User?   @relation(fields: [authorId], references: [id])
  authorId  Int?
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Directory {
  id        Int        @id @default(autoincrement())
  name      String
  white     Boolean
  createdAt DateTime   @default(now())
  Position  Position[]
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime
  content   String
}

// SAN = Standard Algebraic Notation => https://en.wikipedia.org/wiki/Algebraic_notation_(chess)
// FEN = Forsyth–Edwards Notation => https://en.wikipedia.org/wiki/Forsyth%E2%80%93Edwards_Notation
model Position {
  id          Int       @id @default(autoincrement())
  fen         String    @unique // Format FEN simplifié (ex: "rnbqkbnr/pppppppp/8/8/4P3/8/PPPP1PPP/RNBQKBNR")
  directory   Directory @relation(fields: [directoryId], references: [id])
  directoryId Int
  moves       Move[] // Coups possibles depuis cette position
}

model Move {
  id             Int      @id @default(autoincrement())
  san            String // Format SAN (ex: "e4")
  evaluation     Json? // Données Stockfish (depth, cp, mate, etc.)
  position       Position @relation(fields: [positionId], references: [id])
  positionId     Int
  nextPositionId Int? // Lien à la Position suivante (pour les arbres de variantes)
}
