// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Post {
  id        Int     @id @default(autoincrement())
  title     String
  content   String?
  published Boolean @default(false)
  author    User?   @relation(fields: [authorId], references: [id])
  authorId  Int?
}

model User {
  id    Int     @id @default(autoincrement())
  email String  @unique
  name  String?
  posts Post[]
}

model Directory {
  id        Int      @id @default(autoincrement())
  name      String
  white     Boolean
  createdAt DateTime @default(now())
}

model Comment {
  id        Int      @id @default(autoincrement())
  createdAt DateTime
  content   String
}

// model Move {
//   id           Int @id @default(autoincrement())
//   directoryId
//   parentMoveId
//   content
// }

// SAN = Standard Algebraic Notation => https://en.wikipedia.org/wiki/Algebraic_notation_(chess)
// FEN = Forsyth–Edwards Notation => https://en.wikipedia.org/wiki/Forsyth%E2%80%93Edwards_Notation
// Pour la 1ère position d'un répertoire,
//  => le parentPos peut être NULL 
//  => le SAN peut être NULL
model Position {
  id          Int     @id @default(autoincrement())
  directoryId Int
  SAN         String?
  FEN         String
  parentPosId Int?
}
